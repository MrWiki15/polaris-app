# My Business  Hub - Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit the actual .env file to version control

# ============================================
# Supabase Configuration
# ============================================
# Get these from your Supabase project dashboard:
# https://app.supabase.com/projects
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# Local Encryption (for wallet security)
# ============================================
# Generate a random 32-byte hex string for local encryption
VITE_ENCRIPTED_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ============================================
# Blockchain (Hedera/Plume)
# ============================================
# Hedera testnet RPC endpoint
VITE_RPC_URL=http://rpc.plume.org

# Your Hedera operator account (format: 0.0.XXXXXX)
VITE_OPERATOR_ID=0.0.XXXXXX

# Your Hedera operator private key (ECDSA)
# WARNING: Keep this secret! Never share it!
VITE_OPERATOR_KEY=302e020100300506032b657004220420xxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# Pinata IPFS Configuration
# ============================================
# Get these from https://www.pinata.cloud/
# These are used for storing NFT metadata and assets
VITE_PINATA_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_PINATA_JWT_SECRET=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_PINATA_URL=https://your-gateway-name.mypinata.cloud

# ============================================
# Google Gemini AI
# ============================================
# Get your API key from: https://ai.google.dev/
# Used for AI-powered features (chatbot, analysis, suggestions)
VITE_GOOGLE_AI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
